  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uB9C8\uC744\uC8FC\uBBFC"
    text: "\uC548\uB155! \uD639\uC2DC \uB0B4\uAC00 \uAE08\uC744 \uC783\uC5B4\uBC84\uB838\uB294\uB370
      \n\uC880 \uCC3E\uC544\uC904 \uC218 \uC788\uC744\uAE4C?"
  - speaker: "\uB098"
    text: "\uB124 \uB3C4\uC640\uB4DC\uB9B4\uAC8C\uC694!"
  - speaker: "\uB9C8\uC744\uC8FC\uBBFC"
    text: "\uACE0\uB9C8\uC6CC! \uCD1D 3\uAC1C\uB97C \uCC3E\uC544\uC918\uC57C\uD558\uB294\uB370
      \uC5B4\uB514\uC11C \uC783\uC5B4\uBC84\uB838\uB294\uC9C0 \uBAA8\uB974\uACA0\uC5B4
      \uBBF8\uC548\uD574.."
  choice1: "\uD55C\uBC88 \uC5F4\uC2EC\uD788 \uCC3E\uC544\uBCFC\uAC8C\uC694~"
  choice2: "\uADC0\uCC2E\uC740\uB370 \uB2E4\uC74C\uC5D0 \uD560\uAC8C\uC694."
